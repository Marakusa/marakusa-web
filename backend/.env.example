MONGODB_CONNECTION_STRING=mongodb+srv://<db_username>:<db_password>@cluster0.dooneih.mongodb.net/web-app

HOST=127.0.0.1
PORT=3000
FRONTEND_URL=http://localhost:5173
THUMBNAIL_UPLOAD_DIR=uploads/thumbnails
# Number of reverse proxies in front of the app
# empty = no reverse proxy
# 1 = nginx
# 2 = Cloudflare -> nginx
TRUST_PROXY=

JINXXY_HOST=https://api.creators.jinxxy.com/v1
JINXXY_API_KEY=
JINXXY_STORE_BASE_URL=https://jinxxy.com/Marakusa/

DISCORD_STATE=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/auth/callback

# Generate a secret with `openssl rand -hex 32`
JWT_SECRET=
BOT_API_KEY=
LICENSE_KEY_SALT=

APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
APPWRITE_PROFILES_COLLECTION=
APPWRITE_LICENSES_COLLECTION=
APPWRITE_PRODUCTS_COLLECTION=
